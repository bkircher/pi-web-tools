{
	"name": "@bkircher/pi-web-tools",
	"version": "0.2.0",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test": "tsx --test tests/*.test.ts",
		"typecheck": "tsc"
	},
	"files": [
		"extensions"
	],
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"engines": {
		"node": ">=26"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"@earendil-works/pi-ai": {
			"@smithy/node-http-handler": "4.13.0"
		},
		"@earendil-works/pi-coding-agent": {
			"undici": "8.12.3"
		},
		"google-auth-library": {
			"google-logging-utils": "1.2.0"
		}
	},
	"description": "Provides web_search and web_fetch tools to pi",
	"author": "bkircher@0xadd.de",
	"license": "MIT"
}
